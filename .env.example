# ===== Viralab ortam değişkenleri =====
# Bu dosyayı .env.local olarak kopyala ve doldur.
# HİÇBİRİ ZORUNLU DEĞİL — boş bırakılırsa uygulama DEMO MODUNDA çalışır.
# Production ortamında false kalmalı; gerçek servisler yoksa deploy fail etmelidir.
DEMO_MODE=false

# --- Supabase (https://supabase.com → yeni proje → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- YouTube Data API v3 (https://console.cloud.google.com → API anahtarı) ---
YOUTUBE_API_KEY=

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# --- Genel ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Ingestion ---
# mock: API anahtarsız demo verisini Supabase'e basar · live: gerçek YouTube verisi
INGEST_MODE=live

# --- MCP sunucusu (AI asistanlarının indeksi sorgulaması) ---
# Production'da ZORUNLU — boşsa /api/mcp kapalı döner (503).
# Rastgele uzun bir değer üret: openssl rand -hex 32
MCP_API_KEY=
